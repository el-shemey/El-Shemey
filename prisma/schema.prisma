// EL-SHEMEY — core learning domain schema (Phase 3)
// Rationale documented in docs/DATABASE_DESIGN.md and docs/DECISIONS.md (D20).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Delivery channel for OTP challenges.
enum OtpChannel {
  EMAIL
  SMS
}

enum Role {
  USER
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AccessLevel {
  FREE
  PRO
}

enum PublishState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  LESSON
  QUIZ
  PROJECT
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  CREATED
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED

  /// Terminal revocation state set by verified refund events (Phase 7A).
  REFUNDED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

/// Customer-facing payment methods required for Egypt (D21).
/// Provider support per method is verified in Phase 5 before any integration.
enum PaymentMethod {
  CARD
  VODAFONE_CASH
  FAWRY
  INSTAPAY
}

/// Provider-independent payment lifecycle (D21).
/// Adapter-specific statuses map INTO these states — never stored raw.
enum PaymentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Identity anchor only. Credentials/sessions arrive with Auth.js in Phase 4;
/// this model exists so learning state can reference a future user cleanly.
model User {
  id String @id @default(cuid())

  /// Canonical lowercase email. Null when the user registered via phone.
  email String? @unique

  /// Canonical E.164 phone. Null when the user registered via email.
  phone String? @unique

  name String?

  /// Argon2id hash. Null = no credential set (reserved for future OAuth-only).
  passwordHash String?

  emailVerified DateTime?
  phoneVerified DateTime?

  role Role @default(USER)

  /// Incremented on password change/reset — JWT sessions carry this value;
  /// mismatch invalidates the session (revocation without a session table).
  sessionVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments             Enrollment[]
  payments                Payment[]
  subscriptions           Subscription[]
  refundsApproved         Refund[]                 @relation("refundApprover")
  auditEntries            AuditLog[]               @relation("auditActor")
  videosCreated           VideoAsset[]
  authEvents              AuthEvent[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  analyticsEvents         AnalyticsEvent[]
  resourcesCreated        ResourceFile[]
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameAr    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@index([order])
}

model Course {
  id             String       @id @default(cuid())
  slug           String       @unique
  level          Level
  accessLevel    AccessLevel  @default(PRO)
  publishState   PublishState @default(DRAFT)
  publishedAt    DateTime?
  estimatedHours Int?

  titleEn       String
  titleAr       String
  summaryEn     String?
  summaryAr     String?
  descriptionEn String?
  descriptionAr String?

  seoTitleEn String?
  seoTitleAr String?
  seoDescEn  String?
  seoDescAr  String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Phase 8 authoring extensions (admin-authored, server-validated):
  /// { objectives:{en:[],ar:[]}, prerequisites:{en:[],ar:[]},
  ///   instructor:{en,ar}, coverUrl }
  meta Json?

  modules     Module[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishState])
  @@index([categoryId])
}

/// Downloadable lesson resource (Phase 8 Content Factory).
/// Bytes live behind the VideoStorageProvider abstraction; access is
/// authorized through the owning lesson's chain on every download.
model ResourceFile {
  id       String @id @default(cuid())
  lessonId String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  label String

  /// Opaque server-generated key (never exposed to clients).
  storageRef String @unique

  mimeType  String?
  sizeBytes BigInt?
  position  Int     @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([lessonId])
}

model Module {
  id       String @id @default(cuid())
  courseId String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  position     Int
  titleEn      String
  titleAr      String
  publishState PublishState @default(DRAFT)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, position])
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  slug         String
  position     Int
  type         LessonType   @default(LESSON)
  accessLevel  AccessLevel  @default(FREE)
  publishState PublishState @default(DRAFT)

  titleEn String
  titleAr String

  durationSeconds Int?

  /// Opaque reference into the future content system (CMS/blocks).
  /// Shape is intentionally NOT defined here — see CONTENT BOUNDARY in DATABASE_DESIGN.md.
  contentRef Json?

  progressRecords       LessonProgress[]
  videos                VideoAsset[]
  resources             ResourceFile[]
  lastLessonEnrollments Enrollment[]     @relation("enrollmentLastLesson")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId, position])
}

/// Learner ↔ course relationship. One row per user per course.
model Enrollment {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  startedAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  completedAt  DateTime?

  lastLessonId String?
  lastLesson   Lesson? @relation("enrollmentLastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, lastActiveAt])
}

/// Source of truth for lesson completion. Percentages are derived in the
/// domain layer — never stored redundantly here.
model LessonProgress {
  id           String @id @default(cuid())
  enrollmentId String

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// Null = started but not complete. Presence of a value = complete.
  completedAt DateTime?

  /// Duplicate completion events / retries are counted for analytics,
  /// but completion timestamps are never overwritten once set (idempotent).
  completionEvents Int @default(0)

  positionSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

/// Provider-independent payment record (schema prepared in Phase 3,
/// activated in Phase 5 — no payment logic runs before then).
///
/// Rules encoded here (D21):
///  - Money = integer minor units + currency (EGP primary).
///  - (provider, providerRef) is unique → webhook/retry idempotency.
///  - `idempotencyKey` makes creation retries safe.
///  - Only SUCCEEDED may influence entitlements; status transitions are
///    validated by the Phase 5 state machine, never by client input.
///  - NO sensitive data: no card numbers, PINs, or wallet credentials —
///    provider-hosted/tokenized flows only. `rawPayload` holds the
///    verified webhook payload for audit/reconciliation.
model Payment {
  id     String  @id @default(cuid())
  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  method   PaymentMethod
  provider String

  /// Unique transaction/reference from the provider (idempotency anchor).
  providerRef String

  /// Internal key supplied by our checkout creation (retry-safe).
  idempotencyKey String @unique

  amountMinor Int
  currency    String        @default("EGP")
  status      PaymentStatus @default(CREATED)

  /// Phase 5 will add the Subscription entity; until then we retain the
  /// provider-side subscription reference so linkage requires no redesign.
  events  PaymentEvent[]
  refunds Refund[]

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// Provider-side subscription reference (kept even after the entity exists).
  externalSubscriptionId String?

  paidAt     DateTime?
  refundedAt DateTime?
  expiresAt  DateTime?
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([userId])
  @@index([status])
}

/// One-time email verification tokens. Raw tokens are NEVER stored —
/// only SHA-256 hashes. Expired/used rows are purged opportunistically.
model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One-time password reset tokens (same hash-at-rest policy).
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Minimal security audit trail for authentication events.
/// Stores outcome metadata only — never credentials, tokens, or IPs.
model AuthEvent {
  id     String  @id @default(cuid())
  type   String
  email  String?
  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  outcome   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([type, createdAt])
}

/// Purchasable plan. Prices are owner-managed; `isActive=false` until an
/// owner-approved amount is set (never invent pricing). Historical Payments
/// retain their own amounts — changing a Plan never rewrites history.
model Plan {
  id              String          @id @default(cuid())
  slug            String          @unique
  nameEn          String
  nameAr          String
  interval        BillingInterval
  amountMinor     Int             @default(0)
  currency        String          @default("EGP")
  isActive        Boolean         @default(false)
  providerPriceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

/// Server-authoritative subscription lifecycle.
/// Transitions are validated in lib/domain/subscriptions.ts.
model Subscription {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  status         SubscriptionStatus @default(CREATED)
  provider       String?
  providerSubRef String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

/// Append-only webhook/event log. Unique (provider, externalEventId)
/// makes replayed/duplicated webhooks idempotent at the persistence layer.
model PaymentEvent {
  id        String  @id @default(cuid())
  paymentId String?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  provider        String
  externalEventId String
  type            String
  payload         Json?
  receivedAt      DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([paymentId])
}

/// Single-admin-approved refunds with full audit trail (D04b).
model Refund {
  id        String @id @default(cuid())
  paymentId String

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  adminId String
  admin   User   @relation("refundApprover", fields: [adminId], references: [id], onDelete: Restrict)

  amountMinor Int
  currency    String
  reason      String

  status RefundStatus @default(PENDING)

  processedAt DateTime?
  providerRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

/// Self-hosted video asset registered via the Admin Dashboard (owner-managed).
/// `storageRef` is a server-generated opaque key into the pluggable
/// VideoStorageProvider (local FS in development, S3-compatible later) —
/// NEVER a client-visible path. No third-party video provider is used.
model VideoAsset {
  id String @id @default(cuid())

  /// Opaque server-side storage key (e.g. "{videoId}/original.mp4").
  /// Generated by the server; clients never construct or see real paths.
  storageRef String @unique

  title           String
  durationSeconds Int?
  fileSizeBytes   BigInt?
  width           Int?
  height          Int?
  mimeType        String?
  status          VideoStatus @default(PROCESSING)
  thumbnailUrl    String?

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lessonId])
}

/// Tamper-evident-by-append audit trail for sensitive admin operations.
model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Product analytics events (Phase 9). SECURITY/AUDIT events stay in
/// AuthEvent/AuditLog — this table records PRODUCT BEHAVIOR only.
/// Payloads are server-validated and sanitized (no credentials, OTPs,
/// tokens, IPs or free-form PII). Aggregations read these rows; the schema
/// intentionally avoids over-normalization.
model AnalyticsEvent {
  id        String @id @default(cuid())
  eventName String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Validated, sanitized context (e.g. courseSlug, lessonId, amountMinor).
  metadata Json?

  createdAt DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}
